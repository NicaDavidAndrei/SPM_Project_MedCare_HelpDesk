@model IEnumerable<MedCare_HelpDesk.Models.Category>

@{ ViewData["Title"] = "Problem Categories"; }

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-tags me-2"></i>Problem Categories</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-tags-fill me-1"></i> Add Category</a>
    </div>
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form asp-action="Index" method="get" class="d-flex align-items-center">
                <i class="bi bi-search fs-5 text-muted me-3"></i>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 shadow-none" placeholder="Search by Name or Specialty..." />
                <button type="submit" class="btn btn-primary ms-3 rounded-pill px-4">Search</button>
                @if (ViewData["CurrentFilter"] != null) { <a asp-action="Index" class="btn btn-light ms-2 rounded-pill px-4">Clear</a> }
            </form>
        </div>
    </div>
    <div class="content-card p-4 bg-white rounded table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light"><tr><th>ID</th><th>Category</th><th>Specialty Owner</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@item.Id</td>
                        <td class="fw-bold"><i class="bi @(item.IconClass ?? "bi-tag") me-2 text-primary"></i>@item.Name</td>
                        <td>@(item.SpecialtyTag ?? "General Support")</td>
                        <td><span class="badge @(item.IsActive ? "bg-success-subtle text-success border" : "bg-warning-subtle text-dark border")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
