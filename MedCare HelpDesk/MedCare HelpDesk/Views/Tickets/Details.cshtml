@model MedCare_HelpDesk.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container main-container mt-4">
    <div class="content-card col-md-8 mx-auto">
        <h3 class="mb-3">@(Model.TicketCode ?? $"#{Model.Id}") &ndash; @Model.Title</h3>
        <dl class="row">
            <dt class="col-sm-3">Ward</dt><dd class="col-sm-9">@(Model.Department?.Name ?? "N/A")</dd>
            <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@(Model.Category?.Name ?? "N/A")</dd>
            <dt class="col-sm-3">Equipment Tag</dt><dd class="col-sm-9">@(Model.EquipmentTag ?? "—")</dd>
            <dt class="col-sm-3">Status / Priority</dt><dd class="col-sm-9">@Model.Status / @Model.Priority</dd>
            <dt class="col-sm-3">Due Date (UTC)</dt><dd class="col-sm-9">@Model.DueDate</dd>
            <dt class="col-sm-3">Resolved At (UTC)</dt><dd class="col-sm-9">@(Model.ResolvedAt?.ToString() ?? "—")</dd>
            <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Resolution Note</dt><dd class="col-sm-9">@(Model.ResolutionSummary ?? "—")</dd>
        </dl>
        <a asp-action="ViewTicket" asp-route-id="@Model.Id" class="btn btn-info text-white">Open Interactive View</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-light">Back to List</a>
    </div>
</div>
