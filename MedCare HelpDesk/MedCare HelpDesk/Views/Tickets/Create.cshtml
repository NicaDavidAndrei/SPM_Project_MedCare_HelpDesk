@model MedCare_HelpDesk.Models.Ticket

@{
    ViewData["Title"] = "Admin Create Ticket";
}

<div class="container main-container mt-4">
    <div class="content-card col-md-8 mx-auto">
        <h3 class="mb-3"><i class="bi bi-plus-circle me-2"></i>Create Ticket (Admin)</h3>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Title" class="form-label fw-bold"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="EquipmentTag" class="form-label fw-bold">Equipment Tag</label><input asp-for="EquipmentTag" class="form-control" /></div>
            <div class="row mb-3">
                <div class="col-md-6"><label class="form-label fw-bold">Ward</label><select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentList"></select></div>
                <div class="col-md-6"><label class="form-label fw-bold">Category</label><select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList"></select></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="Priority" class="form-label fw-bold"></label><select asp-for="Priority" class="form-select"><option>Critical</option><option>High</option><option selected>Medium</option><option>Low</option></select></div>
                <div class="col-md-6"><label asp-for="Status" class="form-label fw-bold"></label><select asp-for="Status" class="form-select"><option>Open</option><option>In Progress</option><option>Pending Info</option><option>Resolved</option><option>Closed</option></select></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><label class="form-label fw-bold">Requester</label><select asp-for="RequesterId" class="form-select" asp-items="ViewBag.RequesterList"></select></div>
                <div class="col-md-6"><label class="form-label fw-bold">Assigned Agent</label><select asp-for="AssignedAgentId" class="form-select" asp-items="ViewBag.AgentList"><option value="">-- Unassigned --</option></select></div>
            </div>
            <div class="mb-3"><label asp-for="Description" class="form-label fw-bold"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
            <div class="mb-3"><label class="form-label fw-bold">Attachments (.jpg, .png, .pdf &lt;= 5MB)</label><input type="file" name="Attachments" class="form-control" accept=".jpg,.jpeg,.png,.pdf" multiple /></div>
            <button type="submit" class="btn btn-primary">Create Ticket</button>
            <a asp-action="Index" class="btn btn-light ms-2">Back</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
