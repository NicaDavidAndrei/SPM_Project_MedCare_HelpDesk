@model IEnumerable<MedCare_HelpDesk.Models.Ticket>
@using MedCare_HelpDesk.Services

@{
    ViewData["Title"] = "Tickets Management";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-ticket-detailed me-2"></i>Tickets Administration</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Create Ticket</a>
    </div>

    <div class="content-card">
        <form asp-action="Index" method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by Code, Tag, Title..." />
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Code</th><th>Title</th><th>Ward</th><th>Priority</th><th>Status</th><th>SLA</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var sla = TicketService.EvaluateSlaHealthStatic(item);
                        <tr>
                            <td class="fw-bold">@(item.TicketCode ?? $"#{item.Id}")</td>
                            <td>@item.Title</td>
                            <td>@(item.Department?.Name ?? "N/A")</td>
                            <td><span class="badge @(item.Priority == "Critical" ? "bg-critical" : "bg-secondary")">@item.Priority</span></td>
                            <td><span class="badge bg-primary">@item.Status</span></td>
                            <td><span class="badge @(sla.IsBreached ? "bg-danger" : (sla.IsApproaching ? "bg-warning text-dark" : "bg-success"))">@(sla.IsBreached ? "Breached" : (sla.IsResolved ? "Met" : "On Track"))</span></td>
                            <td class="text-end">
                                <a asp-action="ViewTicket" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Open</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
