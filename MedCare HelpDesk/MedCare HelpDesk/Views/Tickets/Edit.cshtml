@model MedCare_HelpDesk.Models.Ticket

@{
    ViewData["Title"] = "Edit Ticket";
}

<div class="container main-container mt-4">
    <div class="content-card col-md-8 mx-auto">
        <h3 class="mb-3"><i class="bi bi-pencil-square me-2"></i>Edit Ticket @(Model.TicketCode ?? $"#{Model.Id}")</h3>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TicketCode" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="DueDate" />
            <input type="hidden" asp-for="ResolvedAt" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Title" class="form-label fw-bold"></label><input asp-for="Title" class="form-control" /></div>
            <div class="mb-3"><label asp-for="EquipmentTag" class="form-label fw-bold"></label><input asp-for="EquipmentTag" class="form-control" /></div>
            <div class="row mb-3">
                <div class="col-md-6"><label class="form-label fw-bold">Ward</label><select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentList"></select></div>
                <div class="col-md-6"><label class="form-label fw-bold">Category</label><select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList"></select></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="Priority" class="form-label fw-bold"></label><select asp-for="Priority" class="form-select"><option>Critical</option><option>High</option><option>Medium</option><option>Low</option></select></div>
                <div class="col-md-6"><label asp-for="Status" class="form-label fw-bold"></label><select asp-for="Status" class="form-select"><option>Open</option><option>In Progress</option><option>Pending Info</option><option>Resolved</option><option>Closed</option></select></div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><label class="form-label fw-bold">Requester</label><select asp-for="RequesterId" class="form-select" asp-items="ViewBag.RequesterList"></select></div>
                <div class="col-md-6"><label class="form-label fw-bold">Assigned Agent</label><select asp-for="AssignedAgentId" class="form-select" asp-items="ViewBag.AgentList"><option value="">-- Unassigned --</option></select></div>
            </div>
            <div class="mb-3"><label asp-for="Description" class="form-label fw-bold"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
            <div class="mb-3"><label asp-for="ResolutionSummary" class="form-label fw-bold"></label><textarea asp-for="ResolutionSummary" class="form-control" rows="2"></textarea></div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-light ms-2">Back</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
