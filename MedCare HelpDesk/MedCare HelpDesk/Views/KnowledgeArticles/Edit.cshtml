@model MedCare_HelpDesk.Models.KnowledgeArticle
@{
    ViewData["Title"] = "Edit Help Guide";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="container main-container">
    <div class="mc-card col-md-8 mx-auto">
        <h3 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Help Guide</h3>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3"><label asp-for="Title" class="form-label fw-bold"></label><input asp-for="Title" class="form-control" required /></div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label fw-bold"></label>
                    <select asp-for="Category" class="form-select">
                        <option>Medical Equipment</option><option>Hospital Software</option><option>IT / Network</option><option>Staff Requests</option>
                    </select>
                </div>
                <div class="col-md-4"><label asp-for="IconClass" class="form-label fw-bold"></label><input asp-for="IconClass" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="ColorClass" class="form-label fw-bold"></label><input asp-for="ColorClass" class="form-control" /></div>
            </div>
            <div class="mb-3">
                <label asp-for="AuthorName" class="form-label fw-bold"></label>
                <input asp-for="AuthorName" class="form-control" readonly="@(!isAdmin)" />
            </div>
            <div class="mb-3"><label asp-for="Content" class="form-label fw-bold"></label><textarea asp-for="Content" class="form-control" rows="6" required></textarea></div>
            <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
            <a asp-action="Index" class="btn btn-light border rounded-pill px-4 ms-2">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
