@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedCare HelpDesk</title>
    <link rel="icon" type="image/svg+xml" href="~/images/headset_guest.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <div class="hotline-banner py-1 px-3 text-center">
            <i class="bi bi-telephone-inbound-fill me-1"></i>
            <strong>REGINA MARIA Craiova 24/7 Emergency Technical Hotline:</strong>
            <span class="mc-mono fw-bold ms-1">+40 251-XXX-911 (Ext. 911)</span>
        </div>

        <nav class="navbar navbar-expand-lg mc-guest-nav py-2">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-body" asp-controller="Home" asp-action="GuestDashboard">
                    <span class="mc-brand-mark" style="width:32px;height:32px;font-size:1rem;"><i class="bi bi-hospital-fill"></i></span>
                    <span>MedCare <span class="text-primary">HelpDesk</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#guestNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="guestNavbar">
                    <ul class="navbar-nav me-auto gap-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold @(currentController == "Home" ? "text-primary" : "")" asp-controller="Home" asp-action="GuestDashboard">
                                <i class="bi bi-grid me-1"></i>Public Portal
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold @(currentController == "KnowledgeBase" ? "text-primary" : "")" asp-controller="KnowledgeBase" asp-action="Index">
                                <i class="bi bi-journal-medical me-1"></i>Knowledge Base
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-2">
                            <i class="bi bi-eye me-1"></i>Guest Visitor (Read-Only)
                        </span>
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2" id="darkModeToggle" title="Toggle Night-Shift Dark Mode">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>
                        <a class="btn btn-sm btn-primary rounded-pill px-3" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Staff Sign In
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <partial name="_ClinicalToasts" />
    <main class="flex-grow-1 py-4">@RenderBody()</main>

    <footer class="border-top py-3 mt-auto text-center small text-muted">
        &copy; 2026 MedCare HelpDesk &bull; REGINA MARIA Craiova &bull; Emergency Hotline: +40 251-XXX-911
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
