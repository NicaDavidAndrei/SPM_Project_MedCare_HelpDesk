@using Microsoft.AspNetCore.Identity
@using MedCare_HelpDesk.Models
@inject UserManager<User> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : "Clinician";
    bool hasProfilePic = !string.IsNullOrEmpty(currentUser?.ProfilePicturePath) && System.IO.File.Exists(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", currentUser.ProfilePicturePath.TrimStart('/')));
    var profilePicUrl = hasProfilePic ? currentUser?.ProfilePicturePath : Url.Content("~/images/person-circle.svg");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedCare Clinical Portal</title>
    <link rel="icon" type="image/svg+xml" href="~/images/headset_user.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="mc-app-shell">
        <div id="mcSidebarBackdrop" class="mc-backdrop"></div>
        <aside id="mcSidebar" class="mc-sidebar">
            <div class="mc-brand-box">
                <a asp-controller="Home" asp-action="UserDashboard" class="d-flex align-items-center gap-2 text-decoration-none text-white">
                    <span class="mc-brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
                    <div>
                        <div class="fw-bold lh-1">MedCare HelpDesk</div>
                        <small class="text-white-50" style="font-size:0.72rem;">REGINA MARIA Craiova</small>
                    </div>
                </a>
                <span class="mc-role-chip mc-chip-user">
                    <i class="bi bi-person-badge-fill"></i> Medical Staff
                </span>
            </div>

            <nav class="mc-nav-list">
                <div class="mc-nav-section">Ward Operations</div>
                <a class="mc-side-link @(currentController == "Home" && currentAction == "UserDashboard" ? "active-page" : "")" asp-controller="Home" asp-action="UserDashboard">
                    <i class="bi bi-house-heart-fill"></i><span>Ward Dashboard</span>
                </a>
                <a class="mc-side-link @(currentController == "Tickets" && currentAction == "SubmitTicket" ? "active-page" : "")" asp-controller="Tickets" asp-action="SubmitTicket">
                    <i class="bi bi-plus-circle-fill text-danger-emphasis"></i><span>Report Issue (&lt;60s)</span>
                </a>
                <a class="mc-side-link @(currentController == "Tickets" && (currentAction == "MyTickets" || currentAction == "ViewTicket") ? "active-page" : "")" asp-controller="Tickets" asp-action="MyTickets">
                    <i class="bi bi-ticket-detailed-fill"></i><span>Ward &amp; My Tickets</span>
                </a>

                <div class="mc-nav-section mt-3">Self-Service</div>
                <a class="mc-side-link @(currentController == "KnowledgeBase" ? "active-page" : "")" asp-controller="KnowledgeBase" asp-action="Index">
                    <i class="bi bi-journal-medical"></i><span>Knowledge Base</span>
                </a>
            </nav>

            <div class="mc-sidebar-hotline">
                <div class="fw-bold text-white mb-1"><i class="bi bi-telephone-inbound-fill text-danger me-1"></i>Wi-Fi / Life-Support Drop</div>
                <div class="mc-mono fw-semibold text-white">+40 251-XXX-911</div>
                <div class="opacity-75">Ext. 911 • 24/7 Emergency Tech</div>
            </div>
        </aside>

        <div class="mc-workspace">
            <header class="mc-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="mcSidebarToggle" class="btn btn-sm btn-outline-secondary d-lg-none" aria-label="Toggle Menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <span class="fw-bold">@ViewData["Title"]</span>
                        <span class="badge bg-secondary-subtle text-secondary border ms-2 mc-mono d-none d-sm-inline" id="liveUtcClock">--:-- UTC</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Tickets" asp-action="SubmitTicket" class="btn btn-sm btn-primary rounded-pill px-3 d-none d-md-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-lg"></i> Report Fault
                    </a>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2" id="darkModeToggle" title="Toggle Night-Shift Dark Mode">
                        <i class="bi bi-moon-fill" id="themeIcon"></i>
                    </button>
                    <div class="dropdown">
                        <a class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@profilePicUrl" alt="Profile" class="rounded-circle @(hasProfilePic ? "" : "opacity-75")" style="width:22px;height:22px;object-fit:cover;" />
                            <span class="fw-semibold d-none d-md-inline">@fullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile &amp; Ward Ext.</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <partial name="_ClinicalToasts" />
            <main class="mc-main-canvas">@RenderBody()</main>

            <footer class="border-top py-3 px-4 text-center small text-muted">
                &copy; 2026 MedCare HelpDesk &bull; REGINA MARIA Craiova &bull; Zero Patient PII Policy
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
