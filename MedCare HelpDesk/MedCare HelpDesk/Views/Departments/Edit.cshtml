@model MedCare_HelpDesk.Models.Department
@{ ViewData["Title"] = "Edit Hospital Ward"; }
<div class="container main-container mt-4">
    <div class="content-card col-md-6 mx-auto">
        <h3 class="mb-3">Edit Hospital Ward</h3>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3"><label asp-for="Name" class="form-label fw-bold"></label><input asp-for="Name" class="form-control" required /></div>
            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="WardCode" class="form-label fw-bold"></label><input asp-for="WardCode" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="WardPhoneExtension" class="form-label fw-bold"></label><input asp-for="WardPhoneExtension" class="form-control" /></div>
            </div>
            <div class="form-check form-switch mb-2"><input asp-for="IsCriticalCare" class="form-check-input" /><label asp-for="IsCriticalCare" class="form-check-label">Critical Care Unit</label></div>
            <div class="form-check form-switch mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Ward Active</label></div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-light ms-2">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
