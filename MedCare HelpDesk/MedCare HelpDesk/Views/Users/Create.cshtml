@model MedCare_HelpDesk.Models.User

@{
    ViewData["Title"] = "Create Staff Account";
}

<div class="container main-container mt-4">
    <div class="content-card col-md-7 mx-auto">
        <h3 class="mb-3"><i class="bi bi-person-plus me-2"></i>Create Staff Account</h3>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row mb-3">
                <div class="col-md-6"><label asp-for="FirstName" class="form-label fw-bold"></label><input asp-for="FirstName" class="form-control" required /></div>
                <div class="col-md-6"><label asp-for="LastName" class="form-label fw-bold"></label><input asp-for="LastName" class="form-control" required /></div>
            </div>
            <div class="mb-3"><label asp-for="Email" class="form-label fw-bold"></label><input asp-for="Email" class="form-control" required /></div>
            <div class="mb-3"><label asp-for="PhoneNumber" class="form-label fw-bold">Ward Phone Extension</label><input asp-for="PhoneNumber" class="form-control" placeholder="+40 251-400-101" /></div>
            <div class="row mb-3">
                <div class="col-md-6"><label class="form-label fw-bold">Hospital Ward</label><select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId"></select></div>
                <div class="col-md-6"><label asp-for="Role" class="form-label fw-bold"></label><select asp-for="Role" class="form-select" asp-items="ViewBag.Roles"></select></div>
            </div>
            <div class="mb-3"><label class="form-label fw-bold">Initial Password (min 8 chars, upper, lower, digit)</label><input type="password" name="PasswordHash" class="form-control" placeholder="Defaults to MedCare123!" /></div>
            <div class="form-check form-switch mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Account Active</label></div>
            <button type="submit" class="btn btn-primary">Create User</button>
            <a asp-action="Index" class="btn btn-light ms-2">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
