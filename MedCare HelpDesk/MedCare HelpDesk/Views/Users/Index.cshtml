@model IEnumerable<MedCare_HelpDesk.Models.User>

@{
    ViewData["Title"] = "Staff Accounts Management";
}

<div class="container main-container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-people text-primary me-2"></i>Hospital Staff Accounts</h2>
            <small class="text-muted">Manage 3 authenticated system roles (<strong>Admin</strong>, <strong>Agent</strong>, <strong>User</strong>). Guests browse unauthenticated.</small>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4"><i class="bi bi-person-plus me-1"></i> Add Staff Account</a>
    </div>

    <div class="mc-card mb-4">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <i class="bi bi-search fs-5 text-muted"></i>
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 shadow-none" placeholder="Search by Name, Email, or Ward..." />
            <button type="submit" class="btn btn-primary rounded-pill px-4">Search</button>
            @if (ViewData["CurrentFilter"] != null)
            {
                <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Clear</a>
            }
        </form>
    </div>

    <div class="mc-card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>ID</th><th>Name</th><th>Email &amp; Ward Ext.</th><th>Role</th><th>Hospital Ward</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string badgeColor = item.Role switch { "Admin" => "bg-danger", "Agent" => "bg-success", _ => "bg-primary" };
                    <tr>
                        <td class="text-muted fw-bold mc-mono">#@item.Id</td>
                        <td class="fw-bold">@item.FirstName @item.LastName</td>
                        <td><div>@item.Email</div><small class="text-muted mc-mono">@item.PhoneNumber</small></td>
                        <td><span class="badge @badgeColor">@(item.Role == "User" ? "Medical Staff (User)" : item.Role)</span></td>
                        <td>@(item.Department?.Name ?? "N/A")</td>
                        <td><span class="badge @(item.IsActive ? "bg-success-subtle text-success border" : "bg-danger-subtle text-danger border")">@(item.IsActive ? "Active" : "Deactivated")</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_BackToTop" />
